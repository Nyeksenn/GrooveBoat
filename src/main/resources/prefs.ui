<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="GrooveboatPrefs" parent="AdwPreferencesDialog">
    <property name="content-width">800</property>
    <property name="content-height">600</property>
    <property name="title" translatable="yes">Preferences</property>
    <child>
      <object class="AdwPreferencesPage" id="connection_page">
        <property name="title" translatable="yes">Subsonic Setup</property>
        <property name="icon-name">interlinked-rectangles-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Authentication</property>
            <property name="description" translatable="yes">Credentials for connecting to the Subsonic API
            </property>
            <child>
              <object class="AdwEntryRow" id="entry_username">
                <property name="title" translatable="yes">Username</property>
              </object>
            </child>
            <child>
              <object class="AdwPasswordEntryRow" id="entry_password">
                <property name="title" translatable="yes">Password</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Connection</property>
            <property name="description" translatable="yes">Connection details for reaching the server
            </property>
            <child>
              <object class="AdwEntryRow" id="entry_url">
                <property name="title" translatable="yes">URL</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>