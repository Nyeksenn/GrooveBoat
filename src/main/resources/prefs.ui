<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="io_github_Nyeksenn_grooveboat_GrooveboatPrefs" parent="AdwPreferencesDialog">
    <property name="content-width">800</property>
    <property name="content-height">600</property>
    <property name="title" translatable="yes">Preferences</property>
    <child>
      <object class="AdwPreferencesPage" id="connection_page">
        <property name="title" translatable="yes">Connection</property>
        <property name="icon-name">interlinked-rectangles-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Color Settings</property>
            <property name="description" translatable="yes">Change the color-scheme of the
              application</property>
            <child>
              <object class="AdwSwitchRow" id="dm_switch">
                <property name="title" translatable="yes">Use Dark Mode</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>