<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MusicControls" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkOverlay">
        <property name="child">
          <object class="GtkScale" id="playback-position-scale">
            <property name="orientation">0</property>
            <property name="margin-bottom">20</property>
            <property name="margin-start">0</property>
            <property name="margin-end">7</property>
            <property name="sensitive">false</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="lower">0</property>
                <property name="upper">100</property>
                <property name="value">0</property>
              </object>
            </property>
            <signal name="change-value" handler="change-value"/>
          </object>
        </property>
        <child type="overlay">
          <object class="GtkLabel" id="timestamp-label">
            <property name="halign">start</property>
            <property name="valign">end</property>
            <property name="label">-:-</property>
            <style>
              <class name="dimmed"/>
            </style>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkLabel" id="duration-label">
            <property name="halign">end</property>
            <property name="valign">end</property>
            <property name="label">-:-</property>
            <style>
              <class name="dimmed"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">horizontal</property>
        <property name="halign">center</property>
        <property name="spacing">20</property>
        <child>
          <object class="GtkButton" id="loop-button">
            <property name="icon-name">loop-arrow-symbolic</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="skip-back-button">
            <property name="icon-name">skip-backward-large-symbolic</property>
            <property name="action-name">win.play-previous</property>
            <style>
              <class name="circular"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="play-button">
            <property name="icon-name">play-symbolic</property>
            <signal name="clicked" handler="play-clicked"/>
            <style>
              <class name="circular"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="skip-forward-button">
            <property name="icon-name">skip-forward-large-symbolic</property>
            <property name="action-name">win.play-next</property>
            <style>
              <class name="circular"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="volume-button">
            <property name="icon-name">speaker-3-symbolic</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>