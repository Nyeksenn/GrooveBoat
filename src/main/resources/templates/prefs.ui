<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="GrooveboatPrefs" parent="AdwPreferencesDialog">
    <property name="content-width">800</property>
    <property name="content-height">600</property>
    <property name="title" translatable="yes">Preferences</property>
    <child>
      <object class="AdwPreferencesPage" id="connection_page">
        <property name="title" translatable="yes">Subsonic Setup</property>
        <property name="icon-name">interlinked-rectangles-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Authentication</property>
            <property name="description" translatable="yes">Credentials for connecting to the Subsonic API
            </property>
            <child>
              <object class="AdwEntryRow" id="entry_username">
                <property name="title" translatable="yes">Username</property>
                <property name="input-purpose">0</property>
                <signal name="changed" handler="connection-details-changed"/>
              </object>
            </child>
            <child>
              <object class="AdwPasswordEntryRow" id="entry_password">
                <property name="title" translatable="yes">Password</property>
                <property name="input-purpose">8</property>
                <signal name="changed" handler="connection-details-changed"/>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Connection</property>
            <property name="description" translatable="yes">Connection details for reaching the server
            </property>
            <child>
              <object class="AdwEntryRow" id="entry_url">
                <property name="title" translatable="yes">URL</property>
                <property name="input-purpose">5</property>
                <signal name="changed" handler="connection-details-changed"/>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="prefs-button-group">
            <property name="visible">false</property>
            <child>
              <object class="GtkBox" id="prefs-button-box">
                <property name="orientation">horizontal</property>
                <property name="halign">end</property>
                <property name="spacing">10</property>
                <child>
                  <object class="GtkButton" id="prefs-revert-button">
                    <property name="name">revert</property>
                    <property name="label">Revert</property>
                    <signal name="clicked" handler="connection-details-revert"/>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="prefs-save-button">
                    <property name="name">save</property>
                    <property name="label">Save</property>
                    <signal name="clicked" handler="connection-details-save"/>
                    <style>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>