<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="CredentialsPage" parent="AdwNavigationPage">
    <property name="title" translatable="yes">Credentials</property>
    <property name="child">
      <object class="AdwToolbarView">
        <property name="content">
          <object class="AdwPreferencesPage">
            <property name="title" translatable="yes">Credentials</property>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Credentials</property>
                <property name="description" translatable="yes">Enter your username and password</property>
                <child>
                  <object class="AdwEntryRow" id="entry-username">
                    <property name="title" translatable="yes">Username</property>
                    <property name="input-purpose">0</property>
                  </object>
                </child>
                <child>
                  <object class="AdwPasswordEntryRow" id="entry-password">
                    <property name="title" translatable="yes">Password</property>
                    <property name="input-purpose">8</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <child type="bottom">
          <object class="GtkActionBar">
            <property name="margin-start">30</property>
            <property name="margin-end">30</property>
            <property name="margin-bottom">15</property>
            <property name="margin-top">15</property>
            <child type="start">
              <object class="GtkButton">
                <property name="label" translatable="yes">Back</property>
                <property name="action-name">navigation.pop</property>
                <style>
                  <class name="raised"/>
                </style>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton">
                <property name="label" translatable="yes">Finish</property>
                <style>
                  <class name="raised"/>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
