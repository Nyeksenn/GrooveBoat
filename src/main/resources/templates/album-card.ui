<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="AlbumCard" parent="GtkBox">
      <property name="orientation">1</property>
    <child>
      <object class="GtkImage" id="album-picture">
          <property name="pixel-size">200</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="album-name">
        <property name="wrap">true</property>
      </object>
    </child>
  </template>
</interface>