<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="SongQueue" parent="AdwBin">
    <property name="child">
      <object class="GtkScrolledWindow" id="queue-scroll-window">
        <property name="propagate-natural-height">true</property>
        <property name="hscrollbar-policy">never</property>
        <property name="child">
          <object class="GtkListView" id="queue-list-view">
            <property name="orientation">1</property>
            <property name="factory">
              <object class="GtkSignalListItemFactory">
                <signal name="setup" handler="queue-list-setup"/>
                <signal name="bind" handler="queue-list-bind"/>
              </object>
            </property>
            <style>
              <class name="transparent-background"/>
            </style>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>