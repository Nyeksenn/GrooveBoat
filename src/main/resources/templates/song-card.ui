<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="SongCard" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="halign">start</property>
    <property name="margin-start">10</property>
    <property name="margin-end">10</property>
    <property name="margin-top">10</property>
    <property name="margin-bottom">10</property>
    <child>
      <object class="GtkImage" id="song-picture">
        <property name="pixel-size">200</property>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkLabel" id="song-name">
            <property name="wrap">true</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="song-artist">
            <property name="wrap">true</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="song-duration">
        <property name="wrap">true</property>
      </object>
    </child>
    <child>
      <object class="GtkGestureClick" id="song-click">
        <signal name="pressed" handler="song-clicked"/>
      </object>
    </child>
  </template>
</interface>