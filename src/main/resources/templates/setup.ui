<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="SetupWindow" parent="AdwDialog">
    <property name="follows-content-size">false</property>
    <property name="can-close">false</property>
    <property name="presentation-mode">ADW_DIALOG_FLOATING</property>
    <property name="child">
      <object class="AdwNavigationView" id="setup-nav-view">
        <child>
          <object class="WelcomePage" id="welcome-page">
            <property name="tag">welcome-page</property>
          </object>
        </child>
        <child>
          <object class="ConnectionPage" id="connection-page">
            <property name="tag">connection-page</property>
          </object>
        </child>
        <child>
          <object class="CredentialsPage" id="credentials-page">
            <property name="tag">credentials-page</property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
