<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="ArtistListView" parent="GtkBox">
    <child>
      <object class="AdwNavigationView" id="artist-nav-view">
        <property name="hexpand">true</property>
        <child>
          <object class="AdwNavigationPage">
            <style>
              <class name="padded"/>
            </style>
            <property name="title" translatable="yes">Artist Page</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">GTK_POLICY_NEVER</property>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="child">
                      <object class="GtkGridView" id="artist-grid-view">
                        <property name="orientation">1</property>
                        <property name="factory">
                          <object class="GtkSignalListItemFactory">
                            <signal name="setup" handler="artist-grid-setup"/>
                            <signal name="bind" handler="artist-grid-bind"/>
                          </object>
                        </property>
                        <style>
                          <class name="transparent-background"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>