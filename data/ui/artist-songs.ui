<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="ArtistSongsPage" parent="AdwNavigationPage">
    <property name="title" translatable="yes">Artist</property>
    <property name="tag">artist-song-list</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox">
            <property name="valign">start</property>
            <child>
              <object class="GtkButton">
                <property name="valign">start</property>
                <property name="has-frame">false</property>
                <property name="child">
                  <object class="AdwButtonContent">
                    <property name="icon-name">go-previous-symbolic</property>
                  </object>
                </property>
                <property name="action-name">navigation.pop</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="artist-page-label">
                <property name="hexpand">true</property>
                <property name="ellipsize">end</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <property name="hscrollbar-policy">never</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">800</property>
                <property name="tightening-threshold">600</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">24</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <child>
                      <object class="GtkLabel" id="empty-label">
                        <property name="visible">false</property>
                        <property name="label" translatable="yes">No songs found</property>
                        <property name="margin-top">48</property>
                        <style>
                          <class name="dimmed"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="album-sections">
                        <property name="orientation">vertical</property>
                        <property name="spacing">24</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
