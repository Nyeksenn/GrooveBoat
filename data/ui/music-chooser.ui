<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MusicChooser" parent="AdwNavigationPage">
    <property name="title" translatable="yes">GrooveBoat</property>
    <property name="tag">content</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="music-chooser-header">
            <property name="title-widget">
              <object class="AdwViewSwitcher" id="music-switcher-title">
                <property name="stack">music-chooser-stack</property>
                <property name="policy">1</property>
              </object>
            </property>
            <child type="start">
              <object class="Avatar" id="account-menu"/>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="pref-menu-button">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="menu-model">preferences-menu</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="button-search">
                <property name="icon-name">edit-find-symbolic</property>
                <signal name="clicked" handler="search-clicked"/>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">1</property>
            <child>
              <object class="GtkProgressBar" id="refresh-progress-bar">
                <property name="visible">false</property>
                <property name="pulse-step">0.1</property>
              </object>
            </child>
            <child>
              <object class="GtkSearchBar" id="album-searchbar">
                <style>
                  <class name="searchbar"/>
                </style>
                <child>
                  <object class="GtkSearchEntry" id="album-searchentry">
                    <property name="hexpand">true</property>
                    <property name="search-delay">300</property>
                    <property name="placeholder-text" translatable="yes">Enter Filter</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkOverlay" id="mini-player-overlay">
                <property name="child">
                  <object class="AdwViewStack" id="music-chooser-stack">
                    <property name="vexpand">true</property>
                    <child>
                      <object class="AdwViewStackPage" id="albumsPage">
                        <property name="name">albums</property>
                        <property name="title" translatable="yes">Albums</property>
                        <property name="icon-name">library-music-symbolic</property>
                        <property name="use-underline">true</property>
                        <property name="child">
                          <object class="AlbumListView" id="album-list-view"/>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwViewStackPage" id="artistsPage">
                        <property name="name">artists</property>
                        <property name="title" translatable="yes">Artists</property>
                        <property name="icon-name">library-artists-symbolic</property>
                        <property name="use-underline">true</property>
                        <property name="child">
                          <object class="ArtistListView" id="artist-list-view"/>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
                <child type="overlay">
                  <object class="MiniPlayer" id="mini-player"/>
                </child>
              </object>
            </child>
          </object>
        </property>
        <child type="bottom">
          <object class="AdwViewSwitcherBar" id="music-switcher-bar">
            <property name="stack">music-chooser-stack</property>
          </object>
        </child>
      </object>
    </property>
  </template>

  <menu id="preferences-menu">
    <section>
      <item>
        <attribute name="label">Refresh</attribute>
        <attribute name="action">app.refresh-data</attribute>
      </item>
      <item>
        <attribute name="label">Full Refresh</attribute>
        <attribute name="action">app.full-refresh</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Log Out</attribute>
        <attribute name="action">app.logout</attribute>
      </item>
    </section>
  </menu>
</interface>