<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="SongCard" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="halign">fill</property>
    <property name="spacing">12</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <property name="margin-top">8</property>
    <property name="margin-bottom">8</property>

    <child>
      <object class="GtkLabel" id="song-track">
        <property name="visible">false</property>
        <property name="valign">center</property>
        <property name="width-chars">2</property>
        <property name="xalign">1</property>
        <style>
          <class name="dimmed"/>
          <class name="numeric"/>
        </style>
      </object>
    </child>
    <child>
      <object class="RoundedImage" id="song-picture">
        <property name="pixel-size">50</property>
        <property name="valign">center</property>
        <property name="halign">center</property>
        <property name="radius">3.0</property>
        <style>
          <class name="album-border"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="valign">center</property>
        <property name="hexpand">true</property>
        <child>
          <object class="GtkLabel" id="song-name">
            <property name="ellipsize">end</property>
            <property name="halign">start</property>
            <property name="hexpand">true</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="song-artist">
            <property name="ellipsize">end</property>
            <property name="halign">start</property>
            <property name="hexpand">true</property>
            <style>
              <class name="dimmed"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="song-duration">
        <property name="halign">end</property>
        <property name="valign">center</property>
        <style>
          <class name="dimmed"/>
          <class name="numeric"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkGestureClick" id="song-click">
        <property name="button">1</property>
        <signal name="pressed" handler="song-clicked"/>
      </object>
    </child>
    <child>
      <object class="GtkGestureClick" id="song-right-click">
        <property name="button">3</property>
        <signal name="pressed" handler="song-right-clicked"/>
      </object>
    </child>
    <child>
      <object class="GtkPopoverMenu" id="song-popover">
        <property name="menu-model">song-context-menu</property>
        <property name="has-arrow">false</property>
        <property name="halign">1</property>
      </object>
    </child>
  </template>

  <menu id="song-context-menu"/>
</interface>