<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="SongListPage" parent="AdwNavigationPage">
    <property name="title" translatable="yes">Page 2</property>
    <property name="tag">album-song-list</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox">
            <property name="valign">start</property>
            <child>
              <object class="GtkButton">
                <property name="valign">start</property>
                <property name="has-frame">false</property>
                <property name="child">
                  <object class="AdwButtonContent">
                    <property name="icon-name">go-previous-symbolic</property>
                  </object>
                </property>
                <property name="action-name">navigation.pop</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="album-page-label">
                <property name="hexpand">true</property>
                <property name="ellipsize">end</property>
              </object>
            </child>
            <child>
              <object class="AdwSplitButton">
                <property name="halign">3</property>
                <property name="icon-name">media-playback-start-symbolic</property>
                <property name="menu-model">album-queue-menu</property>
                <property name="valign">end</property>
                <signal name="clicked" handler="play-album-clicked"/>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwClamp">
            <property name="vexpand">true</property>
            <property name="maximum-size">800</property>
            <property name="tightening-threshold">600</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="vexpand">true</property>
                <property name="hscrollbar-policy">never</property>
                <property name="child">
                  <object class="GtkListView" id="song-list-view">
                    <property name="orientation">1</property>
                    <property name="factory">
                      <object class="GtkSignalListItemFactory">
                        <signal name="setup" handler="song-list-setup"/>
                        <signal name="bind" handler="song-list-bind"/>
                      </object>
                    </property>
                    <style>
                      <class name="transparent-background"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>

  <menu id="album-queue-menu"/>
</interface>