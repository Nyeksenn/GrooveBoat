<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="GrooveboatPrefs" parent="AdwPreferencesDialog">
    <property name="content-width">800</property>
    <property name="content-height">600</property>
    <property name="title" translatable="yes">Preferences</property>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Audio</property>
        <property name="icon-name">audio-speakers-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Playback</property>
            <child>
              <object class="AdwSwitchRow" id="row-gapless">
                <property name="title" translatable="yes">Gapless Playback</property>
                <property name="subtitle" translatable="yes">Play songs back to back without a pause.</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Volume Normalization</property>
            <property name="description" translatable="yes">Evens out the loudness of songs using the ReplayGain tags in the audio files. Changes apply from the next song that is loaded.</property>
            <child>
              <object class="AdwSwitchRow" id="row-replay-gain">
                <property name="title" translatable="yes">ReplayGain</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="row-replay-gain-mode">
                <property name="title" translatable="yes">Mode</property>
                <property name="subtitle" translatable="yes">Album keeps the loudness differences within an album.</property>
                <property name="sensitive" bind-source="row-replay-gain" bind-property="active" bind-flags="sync-create"/>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Track</item>
                      <item translatable="yes">Album</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Streaming Quality</property>
            <property name="description" translatable="yes">Asks the server to re-encode songs above the chosen bitrate. Songs already below it are not re-encoded. Changes apply from the next song that is loaded.</property>
            <child>
              <object class="AdwComboRow" id="row-transcode-unmetered">
                <property name="title" translatable="yes">On Unmetered Connections</property>
                <property name="subtitle" translatable="yes">Used on most connections.</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Original</item>
                      <item translatable="yes">High (320 kbps)</item>
                      <item translatable="yes">Balanced (192 kbps)</item>
                      <item translatable="yes">Data Saver (96 kbps)</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="row-transcode-metered">
                <property name="title" translatable="yes">On Metered Connections</property>
                <property name="subtitle" translatable="yes">Used when the system marks the connection as metered.</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Original</item>
                      <item translatable="yes">High (320 kbps)</item>
                      <item translatable="yes">Balanced (192 kbps)</item>
                      <item translatable="yes">Data Saver (96 kbps)</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="row-transcode-format">
                <property name="title" translatable="yes">Transcoding Format</property>
                <property name="subtitle" translatable="yes">Auto uses Opus on Jellyfin and MP3 on OpenSubsonic. Servers may not support every format.</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Auto</item>
                      <item translatable="yes">Opus</item>
                      <item translatable="yes">AAC</item>
                      <item translatable="yes">MP3</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="row-transcode-unsupported">
                <property name="title" translatable="yes">Transcode Unsupported Formats</property>
                <property name="subtitle" translatable="yes">Otherwise songs this device can't decode are skipped.</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
